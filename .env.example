# Server-only Pinata credential. Never expose this value with NEXT_PUBLIC_.
PINATA_JWT=

# Public gateway host, for example: https://example.mypinata.cloud
NEXT_PUBLIC_GATEWAY_URL=

# Optional canonical production URL. Defaults to the current deployment origin.
NEXT_PUBLIC_APP_URL=

# Optional Base Builder Code suffix. Add only after registering TickerBeat at base.dev.
NEXT_PUBLIC_BASE_BUILDER_CODE_SUFFIX=
